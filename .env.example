POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://iptv:CHANGE_ME@postgres:5432/iptv

APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATA_ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME

PUBLIC_BASE_URL=http://localhost

ACCESS_LOG_RETENTION_DAYS=30
M3U_CACHE_SECONDS=300
EPG_CACHE_SECONDS=3600

# Set true only for local development when sourcing playlists from private IPs
ALLOW_PRIVATE_URLS=false
SETUP_PAGE_ENABLED=true
COOKIE_SECURE=false
HTTP_PORT=80
